source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# force emacs keymap
bindkey -e

# zplug
source $ZPLUG_HOME/init.zsh
zplug "zsh-users/zsh-autosuggestions"
if ! zplug check --verbose; then
  printf "Install? [y/N]: "
  if read -q; then
    echo; zplug install
  fi
fi
zplug load

autoload -U compinit
compinit

# nvm (homebrew install, or the official script's ~/.nvm)
for nvm_sh in /opt/homebrew/opt/nvm/nvm.sh "$NVM_DIR/nvm.sh"; do
  [ -s "$nvm_sh" ] && { source "$nvm_sh"; break; }
done

# auto-switch node version
autoload -U add-zsh-hook
load-nvmrc() {
    local node_version="$(nvm version)"
    local nvmrc_path="$(nvm_find_nvmrc)"

    if [ -n "$nvmrc_path" ]; then
      local nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

      if [ "$nvmrc_node_version" = "N/A" ]; then
        nvm install
      elif [ "$nvmrc_node_version" != "$node_version" ]; then
        nvm use
      fi
    elif [ "$node_version" != "$(nvm version default)" ]; then
      echo "Reverting to nvm default version"
      nvm use default
    fi
}
add-zsh-hook chpwd load-nvmrc
load-nvmrc

# fzf
eval "$(fzf --zsh)"

# starship prompt
eval "$(starship init zsh)"

# zoxide
eval "$(zoxide init zsh)"


# edit command in editor
autoload -z edit-command-line
zle -N edit-command-line
bindkey "^X^E" edit-command-line

# Aliases
alias bs="git bselect"
alias reload!="source ~/.zshrc"
alias st="git st"
alias ls="lsd"
alias ll="lsd -a --color=always --long --git --size=short --icon=always"
alias ip="curl ifconfig.me"
alias genpass="openssl rand -base64 20"
alias path='echo $PATH | tr -s ":" "\n"'
alias lazydocker="upscope lazydocker"
alias gcs="gh copilot suggest"

# Functions
function take {
  mkdir $1
  cd $1
}

function branch_clean() {
  git checkout master && git branch --merged | grep -v master | xargs git branch -d
}

# Docker helpers
docker_rmi() {
    local image
    image=$(docker images | awk '(NR>1) { print $1 " " $3; }' | fzf-tmux -p) \
    && docker rmi $(cut -d' ' -f2 <<< "$image") --force
}

docker_attach() {
    local container
    container=$(docker ps | awk 'NR>1 { print $1 " " $NF; }' | fzf-tmux -p) \
    && docker attach $(cut -d' ' -f1 <<< "$container")
}

docker_stop() {
    local container
    container=$(docker ps | awk 'NR>1 { print $1 " " $NF; }' | fzf-tmux -p) \
    && docker stop $(cut -d' ' -f1 <<< "$container")
}

# Upscope helpers
local container_list=("api" "api-worker" "app-frontend" "browserless" "data" "idp" "integrations_acme" "js" "mailcatcher" "mongodb" "nginx" "phone" "postgres" "redis" "todomvc" "viewer")
local products=("uv")

function ul() {
   local selected_product=$(printf "%s\n" "${products[@]}" | fzf)
   local selected_container=$(printf "%s\n" "${container_list[@]}" | fzf)
   upscope "$selected_product" docker:"$selected_container" logs -f
}

function ur() {
   local selected_product=$(printf "%s\n" "${products[@]}" | fzf)
   local selected_container=$(printf "%s\n" "${container_list[@]}" | fzf)
   upscope "$selected_product" docker:"$selected_container" restart
}

function ub() {
   upscope uv build cobrowsing
}

function uc() {
   upscope machine sync
}

function ue() {
   local selected_product=$(printf "%s\n" "${products[@]}" | fzf)
   local selected_container=$(printf "%s\n" "${container_list[@]}" | fzf)
   upscope "$selected_product" exec "$selected_container" sh
}

function us() {
  mutagen sync terminate --all
  sleep 2
  upscope machine sync
}

function ut() {
    local selected_product=$(printf "%s\n" "${products[@]}" | fzf)
    upscope "$selected_product" build types
}

function ud() {
  local selected_product=$(printf "%s\n" "${products[@]}" | fzf)
  upscope "$selected_product" db reset
}

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
